# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)
# JWT_SECRET : 32 caractères minimum, aléatoire. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATABASE_URL=
SHADOW_DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=
FRONTEND_BASE_URL=
NODEMAILER_USER=
NODEMAILER_PASSWORD=
NODEMAILER_HOST=
NODEMAILER_PORT=
# Mode test : true en local uniquement (false ou absent en production)
TEST_ENVIRONMENT=
EMAIL_TEST=
POWERBI_DB_HOST=
POWERBI_DB_PORT=
POWERBI_DB_USER=
POWERBI_DB_PASSWORD=
POWERBI_DB_NAME=
# Origines autorisées à appeler l'API avec le cookie de session (séparées par des virgules)
# Par défaut : FRONTEND_BASE_URL (+ http://localhost:5173 en mode test)
FRONTEND_ORIGINS=
# Adresse d'écoute de l'API : 127.0.0.1 en production si nginx est sur la même machine
API_HOST=

