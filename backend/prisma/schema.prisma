generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Livraisons {
  id                      Int                         @id @default(autoincrement())
  user_id                 Int
  quantite_livraison      Int
  nom_livreur             String?                     @db.VarChar(255)
  commentaire_livraison   String?                     @db.VarChar(255)
  signature_expediteur    String?                     @db.VarChar(255)
  files                   String?                     @db.LongText
  type                    Livraisons_type
  statut_livraison        Livraisons_statut_livraison
  role_id                 Int?
  service_id              Int?
  date_livraison          DateTime                    @default(now()) @db.DateTime(0)
  autres_champs_livraison String?                     @db.LongText
  roles                   roles?                      @relation(fields: [role_id], references: [id_role], onDelete: Restrict, map: "Livraisons_ibfk_1")
  services                services?                   @relation(fields: [service_id], references: [id], onDelete: Restrict, map: "Livraisons_ibfk_2")
  users                   users                       @relation(fields: [user_id], references: [id_user], map: "Livraisons_ibfk_4")
  reception_livraison     reception_livraison[]

  @@index([role_id], map: "role_id")
  @@index([service_id], map: "service_id")
  @@index([user_id], map: "user_id")
}

model demandes {
  id                                 Int                     @id @default(autoincrement())
  nom_demandeur                      String?                 @db.VarChar(255)
  date_demande                       DateTime                @db.DateTime(0)
  commentaire                        String?                 @db.Text
  qte_total_demande                  Int
  nomenclature                       String?                 @db.VarChar(255)
  details_demande                    String?                 @db.LongText
  details_demandeur                  String?                 @db.LongText
  statut_demande                     demandes_statut_demande
  user_id                            Int?
  stock_id                           Int?
  item_id                            Int?
  type_demande                       Int?
  role_id_recepteur                  Int?
  demande_livree                     Boolean                 @default(false)
  demande_recue                      Boolean                 @default(false)
  id_demandeur                       Int?
  motif_demande                      String?                 @db.VarChar(255)
  service_demandeur                  Int?
  champs_autre                       String?                 @db.LongText
  files                              String?                 @db.LongText
  is_deleted                         Boolean                 @default(false)
  form_id                            Int?
  type_mouvement_stock               type_mouvement_stock?   @relation(fields: [type_demande], references: [id], onDelete: Restrict, map: "demandes_ibfk_10")
  users_demandes_user_idTousers      users?                  @relation("demandes_user_idTousers", fields: [user_id], references: [id_user], onDelete: Restrict, map: "demandes_ibfk_2")
  roles                              roles?                  @relation(fields: [role_id_recepteur], references: [id_role], map: "demandes_ibfk_3")
  forms                              forms?                  @relation(fields: [form_id], references: [id], onDelete: Restrict, map: "demandes_ibfk_4")
  items                              items?                  @relation(fields: [item_id], references: [id_piece], onDelete: Cascade, map: "demandes_ibfk_6")
  users_demandes_id_demandeurTousers users?                  @relation("demandes_id_demandeurTousers", fields: [id_demandeur], references: [id_user], map: "demandes_ibfk_7")
  services                           services?               @relation(fields: [service_demandeur], references: [id], map: "demandes_ibfk_8")
  stocks                             stocks?                 @relation(fields: [stock_id], references: [id], onDelete: Cascade, map: "demandes_ibfk_9")
  fichiers                           fichiers[]
  mouvement_stock                    mouvement_stock[]
  reception_piece                    reception_piece[]
  validation_demande                 validation_demande[]
  livraison_piece                    livraison_piece[]

  @@index([id_demandeur], map: "id_demandeur")
  @@index([role_id_recepteur], map: "role_id_recepteur")
  @@index([service_demandeur], map: "service_demandeur")
  @@index([user_id], map: "user_id")
  @@index([stock_id], map: "stock_id")
  @@index([type_demande], map: "type_demande")
  @@index([item_id], map: "item_id")
  @@index([form_id], map: "form_id")
}

model items {
  id_piece              Int                     @id @default(autoincrement())
  nom_piece             String                  @db.VarChar(255)
  type                  items_type?
  created_at            DateTime?               @db.DateTime(0)
  created_by            String?                 @db.VarChar(255)
  user_id               Int?
  is_deleted            Boolean                 @default(false)
  demandes              demandes[]
  users                 users?                  @relation(fields: [user_id], references: [id_user], onDelete: Restrict, map: "items_ibfk_3")
  items_models          items_models[]
  items_services        items_services[]
  mouvement_stock       mouvement_stock[]
  reception_piece       reception_piece[]
  stock_carton          stock_carton[]
  stock_lot             stock_lot[]
  stock_piece           stock_piece[]
  stocks                stocks[]
  pieces_rebut          pieces_rebut[]
  history_piece_rebut   history_piece_rebut[]
  mouvement_piece_rebut mouvement_piece_rebut[]

  @@index([user_id], map: "user_id")
}

model items_models {
  item_id     Int
  model_id    Int
  items       items       @relation(fields: [item_id], references: [id_piece], onDelete: Cascade, map: "items_models_ibfk_1")
  model_piece model_piece @relation(fields: [model_id], references: [id_model], onDelete: Cascade, map: "items_models_ibfk_2")

  @@id([item_id, model_id])
  @@index([model_id], map: "model_id")
}

model items_services {
  item_id    Int
  service_id Int
  items      items    @relation(fields: [item_id], references: [id_piece], onDelete: Cascade, map: "items_services_ibfk_1")
  services   services @relation(fields: [service_id], references: [id], onDelete: Cascade, map: "items_services_ibfk_2")

  @@id([item_id, service_id])
  @@index([service_id], map: "service_id")
}

model livraison {
  id_livraison               Int                         @id @default(autoincrement())
  statut_livraison           livraison_statut_livraison  @default(en_cours)
  qte_totale_livraison       Int
  produitsLivre              String                      @db.LongText
  commentaire                String?                     @db.LongText
  date_livraison             DateTime                    @db.DateTime(0)
  deleted                    Boolean                     @default(false)
  date_deleted               DateTime?                   @db.DateTime(0)
  user_id                    Int?
  signature_expediteur       String                      @db.VarChar(255)
  nom_livreur                String?                     @db.VarChar(255)
  type_livraison_id          Int?
  service_id                 Int?
  role_id                    Int?
  model_id                   Int?
  stock_id                   Int?
  form_id                    Int?
  fichiers                   fichiers[]
  users                      users?                      @relation(fields: [user_id], references: [id_user], onDelete: Restrict, onUpdate: Restrict, map: "livraison_ibfk_1")
  type_livraison_commerciale type_livraison_commerciale? @relation(fields: [type_livraison_id], references: [id_type_livraison], onDelete: Restrict, onUpdate: Restrict, map: "livraison_ibfk_2")
  services                   services?                   @relation(fields: [service_id], references: [id], onDelete: Restrict, map: "livraison_ibfk_3")
  roles                      roles?                      @relation(fields: [role_id], references: [id_role], onDelete: Restrict, map: "livraison_ibfk_4")
  model_piece                model_piece?                @relation(fields: [model_id], references: [id_model], onDelete: Restrict, map: "livraison_ibfk_5")
  stocks                     stocks?                     @relation(fields: [stock_id], references: [id], map: "livraison_ibfk_6")
  forms                      forms?                      @relation(fields: [form_id], references: [id], onDelete: Restrict, map: "livraison_ibfk_7")
  mouvement_stock            mouvement_stock[]
  validations                validations[]
  sn_livraison               sn_livraison[]

  @@index([model_id], map: "model_id")
  @@index([role_id], map: "role_id")
  @@index([service_id], map: "service_id")
  @@index([type_livraison_id], map: "type_livraison_id")
  @@index([user_id], map: "user_id")
  @@index([stock_id], map: "stock_id")
  @@index([form_id], map: "form_id")
}

model sn_livraison {
  id               Int       @id @default(autoincrement())
  serial_number    String    @db.VarChar(255)
  point_marchand   String?   @db.VarChar(255)
  caisse           String?   @db.VarChar(255)
  mobile_money     String?   @db.VarChar(255)
  banque           String?   @db.VarChar(255)
  commentaire      String?   @db.VarChar(255)
  created_at       DateTime  @default(now()) @db.DateTime(0)
  is_deleted       Boolean   @default(false)
  livraison_id     Int
  updated_at       DateTime? @db.DateTime(0)
  last_modified_at DateTime  @default(now()) @db.DateTime(0)
  livraison        livraison @relation(fields: [livraison_id], references: [id_livraison], onDelete: Restrict, map: "sn_livraison_ibfk_1")

  @@index([serial_number], map: "serial_number")
  @@index([livraison_id], map: "livraison_id")
}

model livraison_piece {
  id                Int       @id @default(autoincrement())
  demande_id        Int?
  details_demande   String?   @db.LongText
  details_demandeur String?   @db.LongText
  form_id           Int?
  stock_id          Int?
  forms             forms?    @relation(fields: [form_id], references: [id], onDelete: Restrict, map: "livraison_piece_ibfk_3")
  stocks            stocks?   @relation(fields: [stock_id], references: [id], onDelete: Restrict, map: "livraison_piece_ibfk_4")
  demandes          demandes? @relation(fields: [demande_id], references: [id], onDelete: Restrict, map: "livraison_piece_ibfk_5")

  @@index([stock_id], map: "stock_id")
  @@index([form_id], map: "form_id")
  @@index([demande_id], map: "demande_id")
}

model model_piece {
  id_model                                              Int               @id @default(autoincrement())
  nom_model                                             String?           @db.VarChar(255)
  items_models                                          items_models[]
  livraison                                             livraison[]
  mouvement_stock                                       mouvement_stock[]
  remplacements_remplacements_old_model_idTomodel_piece remplacements[]   @relation("remplacements_old_model_idTomodel_piece")
  remplacements_remplacements_new_model_idTomodel_piece remplacements[]   @relation("remplacements_new_model_idTomodel_piece")
  serial_numbers                                        serial_numbers[]
  stock_carton                                          stock_carton[]
  stock_lot                                             stock_lot[]
  stock_piece                                           stock_piece[]
  stocks                                                stocks[]
  parc_tpe                                              parc_tpe[]
}

model mouvement_stock {
  id                                                     Int                   @id @default(autoincrement())
  type                                                   mouvement_stock_type
  mouvement                                              Int?
  formulaire_id                                          Int?
  demande_id                                             Int?
  created_at                                             DateTime              @default(now()) @db.DateTime(0)
  stock_id                                               Int?
  piece_id                                               Int
  service_origine                                        Int?
  service_destination                                    Int?
  origine                                                String?               @db.VarChar(255)
  destination                                            String?               @db.VarChar(255)
  model_id                                               Int
  stock_initial                                          Int?
  quantite                                               Int?
  stock_final                                            Int?
  quantite_totale_piece                                  Int?
  motif                                                  String?               @db.Text
  commentaire                                            String?               @db.LongText
  details_mouvement                                      String?               @db.LongText
  services_mouvement_stock_service_origineToservices     services?             @relation("mouvement_stock_service_origineToservices", fields: [service_origine], references: [id], map: "mouvement_stock_ibfk_1")
  services_mouvement_stock_service_destinationToservices services?             @relation("mouvement_stock_service_destinationToservices", fields: [service_destination], references: [id], map: "mouvement_stock_ibfk_2")
  demandes                                               demandes?             @relation(fields: [demande_id], references: [id], map: "mouvement_stock_ibfk_3")
  livraison                                              livraison?            @relation(fields: [formulaire_id], references: [id_livraison], map: "mouvement_stock_ibfk_4")
  items                                                  items                 @relation(fields: [piece_id], references: [id_piece], onDelete: Cascade, map: "mouvement_stock_ibfk_5")
  model_piece                                            model_piece           @relation(fields: [model_id], references: [id_model], onDelete: Cascade, map: "mouvement_stock_ibfk_6")
  type_mouvement_stock                                   type_mouvement_stock? @relation(fields: [mouvement], references: [id], onDelete: Restrict, map: "mouvement_stock_ibfk_7")
  stocks                                                 stocks?               @relation(fields: [stock_id], references: [id], map: "mouvement_stock_ibfk_8")

  @@index([demande_id], map: "demande_id")
  @@index([formulaire_id], map: "formulaire_id")
  @@index([model_id], map: "model_id")
  @@index([mouvement], map: "mouvement")
  @@index([piece_id], map: "piece_id")
  @@index([service_destination], map: "service_destination")
  @@index([service_origine], map: "service_origine")
  @@index([stock_id], map: "stock_id")
}

model reception_livraison {
  id_reception          Int                                  @id @default(autoincrement())
  livraison_id          Int
  date_reception        DateTime                             @default(now()) @db.DateTime(0)
  user_id               Int
  nom_recepteur         String?                              @db.VarChar(255)
  commentaire_reception String?                              @db.LongText
  signature_recepteur   String?                              @db.VarChar(255)
  statut_reception      reception_livraison_statut_reception
  Livraisons            Livraisons                           @relation(fields: [livraison_id], references: [id], map: "reception_livraison_ibfk_1")
  users                 users                                @relation(fields: [user_id], references: [id_user], map: "reception_livraison_ibfk_2")

  @@index([livraison_id], map: "livraison_id")
  @@index([user_id], map: "user_id")
}

model remplacements {
  id                                                  Int                       @id @default(autoincrement())
  quantite                                            Int
  details_remplacement                                String                    @db.LongText
  commentaire                                         String?                   @db.LongText
  date_remplacement                                   DateTime                  @default(now()) @db.DateTime(0)
  user_id                                             Int
  old_model_id                                        Int
  new_model_id                                        Int
  service_id                                          Int
  role_id                                             Int
  deleted                                             Boolean                   @default(false)
  nom_livreur                                         String?                   @db.VarChar(255)
  signature_expediteur                                String?                   @db.VarChar(255)
  details_parametrage                                 String?                   @db.LongText
  statut                                              remplacements_statut
  form_id                                             Int?
  fichiers                                            fichiers[]
  users                                               users                     @relation(fields: [user_id], references: [id_user], map: "remplacements_ibfk_1")
  model_piece_remplacements_old_model_idTomodel_piece model_piece               @relation("remplacements_old_model_idTomodel_piece", fields: [old_model_id], references: [id_model], map: "remplacements_ibfk_2")
  model_piece_remplacements_new_model_idTomodel_piece model_piece               @relation("remplacements_new_model_idTomodel_piece", fields: [new_model_id], references: [id_model], map: "remplacements_ibfk_3")
  services                                            services                  @relation(fields: [service_id], references: [id], map: "remplacements_ibfk_4")
  roles                                               roles                     @relation(fields: [role_id], references: [id_role], map: "remplacements_ibfk_5")
  forms                                               forms?                    @relation(fields: [form_id], references: [id], onDelete: Restrict, map: "remplacements_ibfk_6")
  validation_remplacement                             validation_remplacement[]

  @@index([new_model_id], map: "new_model_id")
  @@index([old_model_id], map: "old_model_id")
  @@index([role_id], map: "role_id")
  @@index([service_id], map: "service_id")
  @@index([user_id], map: "user_id")
  @@index([form_id], map: "form_id")
}

model roles {
  id_role       Int             @id @default(autoincrement())
  nom_role      String?         @db.VarChar(255)
  description   String?         @db.LongText
  Livraisons    Livraisons[]
  demandes      demandes[]
  livraison     livraison[]
  remplacements remplacements[]
  user_roles    user_roles[]
}

model services {
  id                                                            Int               @id @default(autoincrement())
  nom_service                                                   String?           @db.VarChar(255)
  code_service                                                  String?           @db.VarChar(255)
  Livraisons                                                    Livraisons[]
  demandes                                                      demandes[]
  items_services                                                items_services[]
  livraison                                                     livraison[]
  mouvement_stock_mouvement_stock_service_origineToservices     mouvement_stock[] @relation("mouvement_stock_service_origineToservices")
  mouvement_stock_mouvement_stock_service_destinationToservices mouvement_stock[] @relation("mouvement_stock_service_destinationToservices")
  remplacements                                                 remplacements[]
  serial_numbers                                                serial_numbers[]
  stock_carton                                                  stock_carton[]
  stock_lot                                                     stock_lot[]
  stock_piece                                                   stock_piece[]
  stocks                                                        stocks[]
  user_services                                                 user_services[]
}

model stock_carton {
  id                    Int              @id @default(autoincrement())
  numero_carton         Int?
  nom_carton            String?          @db.VarChar(255)
  stock_id              Int?
  lot_id                Int?
  numero_lot            Int?
  piece_id              Int
  service_id            Int
  model_id              Int
  quantite_piece_carton Int?
  quantite_totale_piece Int?
  is_deleted            Boolean          @default(false)
  serial_numbers        serial_numbers[]
  items                 items            @relation(fields: [piece_id], references: [id_piece], onDelete: Cascade, map: "stock_carton_ibfk_1")
  stock_lot             stock_lot?       @relation(fields: [lot_id], references: [id], onDelete: Cascade, map: "stock_carton_ibfk_2")
  services              services         @relation(fields: [service_id], references: [id], onDelete: Cascade, map: "stock_carton_ibfk_3")
  model_piece           model_piece      @relation(fields: [model_id], references: [id_model], onDelete: Cascade, map: "stock_carton_ibfk_4")
  stocks                stocks?          @relation(fields: [stock_id], references: [id], onDelete: Cascade, map: "stock_carton_ibfk_5")

  @@index([lot_id], map: "lot_id")
  @@index([model_id], map: "model_id")
  @@index([piece_id], map: "piece_id")
  @@index([service_id], map: "service_id")
  @@index([stock_id], map: "stock_id")
}

model stock_lot {
  id                  Int              @id @default(autoincrement())
  numero_lot          Int?
  nom_lot             String?          @db.VarChar(255)
  stock_id            Int?
  quantite_carton_lot Int?
  quantite_carton     Int              @default(0)
  quantite_piece      Int              @default(0)
  piece_id            Int
  service_id          Int
  model_id            Int
  is_deleted          Boolean          @default(false)
  serial_numbers      serial_numbers[]
  stock_carton        stock_carton[]
  items               items            @relation(fields: [piece_id], references: [id_piece], onDelete: Cascade, map: "stock_lot_ibfk_1")
  services            services         @relation(fields: [service_id], references: [id], onDelete: Cascade, map: "stock_lot_ibfk_2")
  model_piece         model_piece      @relation(fields: [model_id], references: [id_model], onDelete: Cascade, map: "stock_lot_ibfk_3")
  stocks              stocks?          @relation(fields: [stock_id], references: [id], onDelete: Cascade, map: "stock_lot_ibfk_4")

  @@index([model_id], map: "model_id")
  @@index([piece_id], map: "piece_id")
  @@index([service_id], map: "service_id")
  @@index([stock_id], map: "stock_id")
}

model stock_piece {
  id          Int         @id @default(autoincrement())
  piece_id    Int
  service_id  Int
  model_id    Int
  quantite    Int         @default(0)
  items       items       @relation(fields: [piece_id], references: [id_piece], onDelete: Cascade, map: "stock_piece_ibfk_1")
  services    services    @relation(fields: [service_id], references: [id], onDelete: Cascade, map: "stock_piece_ibfk_2")
  model_piece model_piece @relation(fields: [model_id], references: [id_model], onDelete: Cascade, map: "stock_piece_ibfk_3")

  @@index([model_id], map: "model_id")
  @@index([piece_id], map: "piece_id")
  @@index([service_id], map: "service_id")
}

model type_demande {
  id_type_demande  Int    @id @default(autoincrement())
  nom_type_demande String @db.VarChar(255)
}

model type_livraison_commerciale {
  id_type_livraison  Int         @id @default(autoincrement())
  nom_type_livraison String?     @db.VarChar(255)
  created_by         String?     @db.VarChar(255)
  user_id            Int?
  is_deleted         Boolean     @default(false)
  livraison          livraison[]
  users              users?      @relation(fields: [user_id], references: [id_user], onDelete: Restrict, map: "type_livraison_commerciale_ibfk_1")

  @@index([user_id], map: "user_id")
}

model type_mouvement_stock {
  id              Int               @id @default(autoincrement())
  type            String            @db.VarChar(255)
  titre           String            @db.VarChar(255)
  demandes        demandes[]
  mouvement_stock mouvement_stock[]
}

model type_parametrage {
  id              Int     @id @default(autoincrement())
  nom_parametrage String? @db.VarChar(255)
}

model user_roles {
  user_id Int
  role_id Int
  users   users @relation(fields: [user_id], references: [id_user], map: "user_roles_ibfk_3")
  roles   roles @relation(fields: [role_id], references: [id_role], map: "user_roles_ibfk_4")

  @@id([user_id, role_id])
  @@index([role_id], map: "role_id")
}

model user_services {
  user_id    Int
  service_id Int
  services   services @relation(fields: [service_id], references: [id], map: "user_services_ibfk_1")
  users      users    @relation(fields: [user_id], references: [id_user], map: "user_services_ibfk_2")

  @@id([user_id, service_id])
  @@index([service_id], map: "service_id")
}

model users {
  id_user                               Int                          @id @default(autoincrement())
  fullname                              String?                      @db.VarChar(255)
  username                              String?                      @db.VarChar(255)
  password                              String?                      @db.VarChar(255)
  email                                 String?                      @db.VarChar(255)
  reset_token                           String?                      @db.VarChar(255)
  reset_expires                         DateTime?                    @db.DateTime(0)
  created_at                            DateTime?                    @default(now()) @db.DateTime(0)
  is_deleted                            Int?                         @default(0) @db.TinyInt
  Livraisons                            Livraisons[]
  demandes_demandes_user_idTousers      demandes[]                   @relation("demandes_user_idTousers")
  demandes_demandes_id_demandeurTousers demandes[]                   @relation("demandes_id_demandeurTousers")
  fichiers                              fichiers[]
  form_signatures                       form_signatures[]
  forms_forms_created_byTousers         forms[]                      @relation("forms_created_byTousers")
  forms_forms_updated_byTousers         forms[]                      @relation("forms_updated_byTousers")
  items                                 items[]
  livraison                             livraison[]
  qr_codes                              qr_codes[]
  reception_livraison                   reception_livraison[]
  reception_piece                       reception_piece[]
  remplacements                         remplacements[]
  stocks_stocks_created_byTousers       stocks[]                     @relation("stocks_created_byTousers")
  stocks_stocks_updated_byTousers       stocks[]                     @relation("stocks_updated_byTousers")
  type_livraison_commerciale            type_livraison_commerciale[]
  user_roles                            user_roles[]
  user_services                         user_services[]
  validation_demande                    validation_demande[]
  validation_remplacement               validation_remplacement[]
  validations                           validations[]
  stockOwner                            stocks[]
  tpe_created                           parc_tpe[]                   @relation("tpe_created_by_user")
