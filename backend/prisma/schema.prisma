  form_id    Int?
  stock_id   Int?
  users      users?     @relation(fields: [created_by], references: [id_user], map: "history_tpe_ibfk_1")
  forms      forms?     @relation(fields: [form_id], references: [id], map: "history_tpe_ibfk_2")
  stocks     stocks?    @relation(fields: [stock_id], references: [id], map: "history_tpe_ibfk_3")
  parc_tpe   parc_tpe   @relation(fields: [id_tpe], references: [id], map: "history_tpe_ibfk_4")
  statut_tpe statut_tpe @relation(fields: [statut_id], references: [id], map: "history_tpe_ibfk_5")

  @@index([created_by], map: "created_by")
  @@index([form_id], map: "form_id")
  @@index([stock_id], map: "stock_id")
  @@index([id_tpe], map: "id_tpe")
  @@index([statut_id], map: "statut_id")
}

model statut_tpe {
  id          Int           @id @default(autoincrement())
  statut      String        @db.VarChar(255)
  parc_tpe    parc_tpe[]
  history_tpe history_tpe[]

  @@index([statut], map: "statut")
}

model demande_rebut {
  id               Int                  @id @default(autoincrement())
  form_id          Int
  statut           demande_rebut_statut
  quantite         Int?
  liste_rebut      String?              @db.LongText
  forms            forms                @relation(fields: [form_id], references: [id], onDelete: Restrict, map: "demande_rebut_ibfk_1")
  validation_rebut validation_rebut[]
  sn_rebut         sn_rebut[]

  @@index([form_id], map: "form_id")
}

model validation_rebut {
  id          Int                   @id @default(autoincrement())
  demande_id  Int
  form_id     Int
  type        type_validation_rebut
  quantite    Int?
  liste_rebut String?               @db.LongText

  demande_rebut demande_rebut @relation(fields: [demande_id], references: [id], onDelete: Restrict, map: "validation_rebut_ibfk_1")
  forms         forms         @relation(fields: [form_id], references: [id], onDelete: Restrict, map: "validation_rebut_ibfk_2")

  @@index([demande_id], map: "demande_id")
  @@index([form_id], map: "form_id")
}

model sn_rebut {
  id                  Int                   @id @default(autoincrement())
  sn_id               Int
  rebut_id            Int?
  decom_id            Int?
  point_marchand      String?               @db.VarChar(255)
  etat                String?               @db.VarChar(255)
  commentaire         String?               @db.VarChar(255)
  created_at          DateTime              @default(now()) @db.DateTime(0)
  updated_at          DateTime?             @db.DateTime(0)
  last_modified_at    DateTime              @default(now()) @db.DateTime(0)
  created_by          Int?
  updated_by          Int?
  pieces_recuperees   String?               @db.LongText
  pieces_defectueuses String?               @db.LongText
  is_deleted          Boolean               @default(false)
  demande_rebut       demande_rebut?        @relation(fields: [rebut_id], references: [id], onDelete: Restrict, map: "sn_rebut_ibfk_1")
  user_create         users?                @relation("sn_rebut_created_by_user", fields: [created_by], references: [id_user], onDelete: SetNull, map: "sn_rebut_ibfk_3")
  user_update         users?                @relation("sn_rebut_updated_by_user", fields: [updated_by], references: [id_user], onDelete: SetNull, map: "sn_rebut_ibfk_4")
  parc_tpe            parc_tpe              @relation(fields: [sn_id], references: [id], onDelete: NoAction, map: "sn_rebut_ibfk_5")
  decom               form_decom?           @relation(fields: [decom_id], references: [id], onDelete: SetNull, map: "sn_rebut_ibfk_6")
  history_piece_rebut history_piece_rebut[]

  @@index([rebut_id], map: "rebut_id")
  @@index([created_by], map: "created_by")
  @@index([updated_by], map: "updated_by")
  @@index([sn_id], map: "sn_id")
}

model pieces_rebut {
  sn_id       Int
  piece_id    Int
  etat        etat_piece_rebut
  created_at  DateTime         @default(now()) @db.DateTime(0)
  updated_at  DateTime?        @db.DateTime(0)
  created_by  Int
  updated_by  Int?
  parc_tpe    parc_tpe         @relation(fields: [sn_id], references: [id], map: "pieces_rebut_ibfk_1")
  items       items            @relation(fields: [piece_id], references: [id_piece], map: "pieces_rebut_ibfk_2")
  user_create users            @relation("pieces_rebut_created_by_user", fields: [created_by], references: [id_user], onDelete: NoAction, map: "pieces_rebut_ibfk_3")
  user_update users?           @relation("pieces_rebut_updated_by_user", fields: [updated_by], references: [id_user], onDelete: SetNull, map: "pieces_rebut_ibfk_4")

  @@id([sn_id, piece_id])
  @@index([sn_id], map: "sn_id")
  @@index([piece_id], map: "piece_id")
}

model history_piece_rebut {
  id         Int              @id @default(autoincrement())
  sn_id      Int
  piece_id   Int
  created_at DateTime         @default(now()) @db.DateTime(0)
  created_by Int
  etat       etat_piece_rebut
  sn_rebut   sn_rebut         @relation(fields: [sn_id], references: [id], onDelete: Cascade, map: "history_piece_rebut_ibfk_1")
  items      items            @relation(fields: [piece_id], references: [id_piece], map: "history_piece_rebut_ibfk_2")
  users      users            @relation(fields: [created_by], references: [id_user], map: "history_piece_rebut_ibfk_3")

  @@index([sn_id], map: "sn_id")
  @@index([piece_id], map: "piece_id")
  @@index([created_by], map: "created_by")
}

model mouvement_piece_rebut {
  id                          Int                        @id @default(autoincrement())
  sn_id                       Int
  piece_id                    Int
  reste_pieces_fonctionnelles String?                    @db.LongText
  reste_pieces_defectueuses   String?                    @db.LongText
  mouvement                   type_mouvement_piece_rebut
  created_at                  DateTime                   @default(now()) @db.DateTime(0)
  created_by                  Int
  parc_tpe                    parc_tpe                   @relation(fields: [sn_id], references: [id], map: "mouvement_piece_rebut_ibfk_1")
  items                       items                      @relation(fields: [piece_id], references: [id_piece], map: "mouvement_piece_rebut_ibfk_2")
  users                       users                      @relation(fields: [created_by], references: [id_user], map: "mouvement_piece_rebut_ibfk_3")

  @@index([sn_id], map: "sn_id")
  @@index([piece_id], map: "piece_id")
  @@index([created_by], map: "created_by")
}

